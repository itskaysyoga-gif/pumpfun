# Copy to .env on the VM. Never commit .env.

# Solana RPC websocket. Start with the public endpoint; switch to a free-tier
# provider (e.g. Helius) if the public one drops too often.
RPC_WS_URL=wss://api.mainnet-beta.solana.com
RPC_HTTP_URL=https://api.mainnet-beta.solana.com

# Where raw events are written
DATA_DIR=./data

# Optional Telegram alerts to your own chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading guard. Leave as-is until Phase 7 is approved.
LIVE=0
WALLET_PUBKEY=
