# systemd --user unit. Installed by deploy/bootstrap_user.sh into
# ~/.config/systemd/user/. Runs without root; lingering keeps it alive after logout.
[Unit]
Description=pumplab collector (pump.fun event stream)
After=network-online.target

[Service]
WorkingDirectory=%h/pumpfun
ExecStart=%h/.local/bin/uv run python scripts/run_collector.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
